    "plugin-recommendation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makima667/dsh-smart-profile.git"
  },
  "homepage": "https://github.com/Makima667/dsh-smart-profile#readme",
  "bugs": {
    "url": "https://github.com/Makima667/dsh-smart-profile/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
