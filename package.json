{
  "name": "dsh-smart-profile",
  "version": "1.0.0",
  "description": "Project stack detection and capability recommendations for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./lib/core.js",
    "./discovery": "./lib/discovery.js",
    "./scoring": "./lib/scoring.js",
    "./install": "./lib/install.js",
    "./compat": "./lib/compat.js",
    "./compose": "./lib/compose.js",
    "./web": "./lib/web.js",
    "./setup": "./lib/setup.js"
  },
  "bin": {
    "dsh-smart-profile": "bin/cli.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/",
    "bin/",
    "README.md",
